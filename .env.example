# Copy to .env and replace these local-only example credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://example_user:example_password@localhost:5432/rahigh_khabar?schema=public&connect_timeout=5&pool_timeout=5&socket_timeout=5"
CORS_ORIGIN="http://localhost:3001"
# REQUIRED: random secret, at least 32 characters. Never commit the generated value.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Explicit units s/m/h/d; from 60 seconds through 7 days.
JWT_EXPIRES_IN=1h
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Empty = don't trust forwarded headers. Only actual proxy IPs/CIDRs are allowed.
# Never trust all addresses. Read README before deploying behind a proxy.
TRUST_PROXY=

# Required: public frontend and public backend origins, respectively. No trailing slash.
PUBLIC_SITE_URL="http://localhost:3001"
PUBLIC_API_URL="http://localhost:3000"
# Local storage is temporary. Railway production MUST use a volume or cloud adapter.
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880
