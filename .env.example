# Copy to .env and replace these local-only example credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://example_user:example_password@localhost:5432/rahigh_khabar?schema=public&connect_timeout=5&pool_timeout=5&socket_timeout=5"
CORS_ORIGIN="http://localhost:3001"
# REQUIRED: random secret, at least 32 characters. Never commit the generated value.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Explicit units s/m/h/d; from 60 seconds through 7 days.
JWT_EXPIRES_IN=1h
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Empty = don't trust forwarded headers. Only actual proxy IPs/CIDRs are allowed.
# Never trust all addresses. Read README before deploying behind a proxy.
TRUST_PROXY=

# Required: public frontend and public backend origins, respectively. No trailing slash.
PUBLIC_SITE_URL="http://localhost:3001"
PUBLIC_API_URL="http://localhost:3000"
# Local storage is temporary. Railway production MUST use a volume or cloud adapter.
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Stage 10 Part 2: Google sign-in (optional) ---
# اگر خالی بمانند، ورود با گوگل غیرفعال می‌شود و بقیهٔ سایت سالم کار می‌کند.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# اختیاری. پیش‌فرض: PUBLIC_API_URL + /auth/google/callback
# باید دقیقاً با Authorized redirect URI در Google Cloud Console یکسان باشد.
GOOGLE_CALLBACK_URL=
# اختیاری. فقط وقتی لازم است که API و سایت روی دو ساب‌دامین مختلف باشند
# مثال: .kodbot.ir — خالی بگذارید تا کوکی host-only (امن‌تر) بماند.
USER_COOKIE_DOMAIN=

# --- آمار و تحلیل (مرحله ۱۰ بخش ۴) ---
# نمک هش بازدیدکننده؛ اگر خالی بماند از JWT_SECRET استفاده می‌شود.
ANALYTICS_HASH_SECRET=
# آخرین بکاپ دیتابیس به فرمت ISO-8601؛ اگر خالی بماند داشبورد «نامشخص» نشان می‌دهد.
DB_BACKUP_LAST_AT=

# --- Stage 10 Part 5 -------------------------------------------------------
# Semantic search (OPTIONAL). Without a key /search runs keyword-only and
# reports `degraded` to the UI.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web Push (OPTIONAL). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Never commit real values: the private key can notify every visitor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# In-process scheduler that publishes SCHEDULED articles.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

